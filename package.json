{
  "name": "@jadchene/mcp-gateway-service",
  "version": "0.13.0",
  "description": "A token-efficient MCP gateway that provides one unified entry point for multiple downstream MCP services.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-gateway-service": "dist/index.js"
  },
  "license": "MIT",
  "author": "jadchene",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadchene/mcp-gateway.git"
  },
  "homepage": "https://github.com/jadchene/mcp-gateway#readme",
  "bugs": {
    "url": "https://github.com/jadchene/mcp-gateway/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json && vite build --configLoader native --config web/vite.config.mjs",
    "dev": "node --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test --experimental-strip-types test/**/*.test.ts && npm run test:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test",
    "version": "node dist/index.js --version",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "build:web": "vite build --configLoader native --config web/vite.config.mjs",
    "test:web": "node --test tests-web/*.test.mjs",
    "verify:web-package": "node scripts/verify-web-package.mjs"
  },
  "files": [
    "dist",
    "skills",
    "config.example.json",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "scripts"
  ],
  "keywords": [
    "mcp",
    "gateway",
    "model context protocol",
    "agent",
    "token-efficient"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "element-plus": "^2.14.8",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "hono": "4.13.14"
  }
}
